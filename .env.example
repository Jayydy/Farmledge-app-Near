# Copy to .env and adjust. Never commit .env.
# Every variable is required: the app and `npm run migrate` refuse to start if
# any is missing or invalid. The values below work with docker-compose.yml.

# --- Environment ------------------------------------------------------------
# test | live. Must match the database: a database is stamped with this value
# the first time it is migrated, and the app refuses to start against a
# database stamped differently.
FARMLEDGE_ENV=test

# Matches the postgres service in docker-compose.yml (host port 5433).
DATABASE_URL=postgresql://farmledge:farmledge@localhost:5433/farmledge

# --- Server -----------------------------------------------------------------
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# How long in-flight requests get to finish on SIGTERM before sockets are closed.
SHUTDOWN_TIMEOUT_MS=10000

# --- Commodities (design doc §10) --------------------------------------------
MAIZE_BAG_SIZE_KG=100
# Moisture limits in basis points of a percent (1350 = 13.50%). The API takes
# and returns moisture as a percentage (13.5); storage and config use basis
# points. See docs/decisions.md. Placeholders until the maize grading
# standard is chosen.
MAIZE_MOISTURE_MIN_BPS=0
MAIZE_MOISTURE_MAX_BPS=1350
# Grading scheme name and its grade codes, best first (docs/decisions.md Q1).
# Switching to a named standard is a config change: every deposit stores the
# scheme with its grade, so old and new grades never mix.
GRADING_SCHEME=provisional
GRADE_VALUES=1,2,3
# Dispatches whose exit weight is more than this share below book kg are
# flagged in the shrinkage report (100 bps = 1%). Placeholder.
MAIZE_SHRINKAGE_TOLERANCE_BPS=200

# --- Deposit intake -----------------------------------------------------------
# Bag counts above BAG_COUNT_MAX are rejected. Counts above
# BAG_COUNT_CONFIRM_ABOVE need an explicit confirm_bag_count flag, so a typo
# (2000 for 200) is caught but a real truckload goes through.
BAG_COUNT_MAX=1000
BAG_COUNT_CONFIRM_ABOVE=300
# Offline captures older than the review age are accepted but flagged for
# review; older than the reject age they are refused (168 h = 7 days).
OFFLINE_REVIEW_AFTER_HOURS=48
OFFLINE_REJECT_AFTER_HOURS=168
# Cancelling a deposit (mistakes only): custodians within this many hours of
# recording it; after that, only the warehouse owner, with a reason.
DEPOSIT_CANCEL_WINDOW_HOURS=24
# Intake photos are stored under <dir>/<FARMLEDGE_ENV>/. Relative paths are
# resolved from the working directory.
PHOTO_STORAGE_DIR=./var/photos
# 5 MB per photo.
PHOTO_MAX_BYTES=5242880

# --- Reporting and fees -------------------------------------------------------
# Calendar days for reports and storage-fee accrual are days in this zone.
BUSINESS_TIMEZONE=Africa/Lagos

# --- Open decisions: switches with working defaults (docs/decisions.md) -------
# false: lending routes answer 501 feature_disabled. true: they validate and
# reach a stub that answers 501 not_implemented.
LENDING_ENABLED=false
# false: chain intents are recorded in the database and no chain is touched.
# true: talk to the receipt contract below through Soroban or NEAR RPC.
CHAIN_ENABLED=false
# stellar | near. Selects which chain adapter is wired when CHAIN_ENABLED=true.
CHAIN_BACKEND=stellar
# tablet_only | sms_two_way. sms_two_way is not built: dispatch answers 501.
CONFIRMATION_MODE=tablet_only
# bag_estimate | scale_required. scale_required records deposits as
# scale-weighed and posts the measured weight once every bag is weighed.
WEIGHT_MODE=bag_estimate
# paper | farmledge (docs/decisions.md D56). paper: the warehouse's own record
# is binding, as in the shadow trial; the tablet never tells staff to hold
# grain Farmledge can't confirm. farmledge: an unconfirmed dispatch means the
# bags stay. Choose farmledge only once receipts carry real claims; refused as
# paper while LENDING_ENABLED is true.
RELEASE_AUTHORITY=paper
# local_dev | kms. kms is not built: the server refuses to start.
KEY_SERVICE=local_dev
# Keys are derived from this; refused in live while it is this example value.
KEY_SERVICE_LOCAL_SECRET=local-dev-only-not-a-secret-change-me-0000
# mock (logs messages instead of sending them).
SMS_GATEWAY=mock

# --- Staff sign-in (docs/decisions.md D41) -------------------------------------
# true: the tablet's intake, dispatch and farmer-balance routes need a staff
# session (Authorization: Bearer).
# false: the acting custodian named in the body is trusted, as before. Refused
# as false in live.
AUTH_REQUIRED=true
# A sign-in stays valid this long on the server, so deposits queued offline can
# still be sent under the session that captured them (168 h = 7 days, the
# offline reject age). The tablet locks itself after a few idle minutes.
STAFF_SESSION_TTL_HOURS=168
# manual (prices entered through POST /prices).
PRICING_PROVIDER=manual

# --- Receipt contract (data_version 3) -------------------------------------
# From the protocol's deployments/testnet.json. With CHAIN_ENABLED=false these
# are validated but nothing connects.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
RECEIPT_CONTRACT_ID=CBW6TA5UJMXJY2VYPJV6WUVWNUP3PKZNPXFMC2CNVCWZDF3SKIT4UAIN
# The deployment's start_ledger: the indexer archives every event from here.
# 5033800 is just before v3's first event (ledger 5033886); confirm it against
# start_ledger in deployments/testnet.json.
RECEIPT_CONTRACT_START_LEDGER=5033800

# --- NEAR receipt contract (used when CHAIN_BACKEND=near) ---------------------
# testnet | mainnet. Non-production FARMLEDGE_ENV must use testnet.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_INDEXER_URL=https://api.testnet.kitwallet.app
NEAR_CONTRACT_ID=farmledge-receipt.team.testnet
NEAR_CONTRACT_START_BLOCK=0
# 0.1 NEAR per managed staff/farmer account on first use (in yoctoNEAR).
NEAR_OPERATOR_FUND_YOCTO=100000000000000000000000

# Farmers' proof links (SMS) point here. The page shows the bundle and checks
# it against a public Stellar RPC, never against this API.
PROOF_LINK_BASE_URL=http://localhost:3000/p
# Event-archive backups are written here. Mount off-site storage at this path.
ARCHIVE_BACKUP_DIR=./var/archive-backups

# --- Placeholders: open decisions, not used yet ------------------------------
# Design doc §3.4: days after the due date before recovery may start.
LOAN_GRACE_PERIOD_DAYS=14
# Design doc §5.5: days allowed for a recovery sale.
RECOVERY_SALE_WINDOW_DAYS=10
# Design doc §11.4: fee rates (bps = basis points; 100 bps = 1%).
FEE_INTAKE_PER_BAG_NGN=0
FEE_COLLATERAL_MONTHLY_BPS=0
FEE_RECOVERY_BPS=0
